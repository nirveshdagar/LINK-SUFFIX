IPROYAL_USER=
IPROYAL_PASS=
MAXMIND_DB_PATH=./GeoLite2-City.mmdb

# API authentication. Set strong, independent values in production.
TAH_API_BEARER_TOKEN=
TAH_ADS_API_TOKEN=
TAH_TRACK_API_TOKEN=
TAH_ALLOW_INSECURE_LOCAL_DEV=false
TAH_ALLOW_UNLISTED_LOCAL_TARGETS=false
TAH_TARGET_POLICY=allowlist
TAH_ALLOWED_TARGETS=
CONTROL_TOKEN=

# Public HTTPS origin used by the hourly Google Ads Script Bridge.
# Google Ads cannot fetch localhost or a private-only address.
TAH_PUBLIC_BASE_URL=
TAH_SCRIPT_BRIDGE_MAX_JOBS=100
TAH_SCRIPT_BRIDGE_LEASE_MS=3000000

# Per-route fixed-window limits.
TAH_ADS_RATE_LIMIT=120
TAH_ADS_RATE_LIMIT_WINDOW_MS=60000
TAH_TRAFFIC_RATE_LIMIT=120
TAH_TRAFFIC_RATE_LIMIT_WINDOW_MS=60000
TAH_TRACK_RATE_LIMIT=120
TAH_TRACK_RATE_LIMIT_WINDOW_MS=60000

# Optional Upstash-compatible Redis REST backend for multi-instance limiting.
# When omitted or unavailable, the app uses bounded in-process storage.
TAH_RATE_LIMIT_REDIS_REST_URL=
TAH_RATE_LIMIT_REDIS_REST_TOKEN=
TAH_RATE_LIMIT_REDIS_TIMEOUT_MS=1500
TAH_RATE_LIMIT_FAIL_CLOSED=true
TAH_TRUST_PROXY_HEADERS=false

# Per-server admission control. Saved campaigns may exceed this value.
TAH_MAX_LOCAL_WORKERS=8
TAH_MAX_ACTIVE_RUNS=500
TAH_MAX_BROWSER_CONCURRENCY=8
TAH_MAX_TOTAL_CONCURRENCY=64
TAH_MAX_TOTAL_RPS=500
TAH_SCHEDULER_INTERVAL_MS=30000

# Resolve ordinary HTTP redirects before allocating an expensive browser.
# Browser fallback remains automatic for JavaScript, challenge, unsafe, and
# unresolved journeys. Captured query strings are never parsed or rebuilt.
TAH_REDIRECT_FIRST_ENABLED=true
TAH_REDIRECT_MAX_HOPS=10
TAH_REDIRECT_HOP_TIMEOUT_MS=10000
TAH_REDIRECT_TOTAL_TIMEOUT_MS=20000
TAH_REDIRECT_FIRST_DEBUG=false
TAH_BLOCK_HEAVY_RESOURCES=true
TAH_BLOCKED_RESOURCE_TYPES=image,media,font
TAH_BODY_CAPTURE_RESOURCE_TYPES=document,xhr,fetch
TAH_MAX_JOURNEY_EVENT_RECORDS=200

# Capacity dashboard planning model. Host/process/disk values remain measured.
TAH_CONTROL_INTERNAL_URL=http://127.0.0.1:3101
TAH_CAPACITY_CAMPAIGN_MEMORY_MB=512
TAH_CAPACITY_CAMPAIGN_CPU_PERCENT=35
TAH_CAPACITY_TARGET_CPU_PERCENT=75
TAH_CAPACITY_MIN_FREE_DISK_RATIO=0.15
TAH_CAPACITY_STORAGE_SCAN_FILES=25000
TAH_CAPACITY_STORAGE_CACHE_MS=60000

# Durable active-passive control plane. Required for multi-server deployment.
DATABASE_URL=postgresql://tah:tah_local_dev@127.0.0.1:55432/tah
TAH_POSTGRES_MAJOR=16
REDIS_URL=redis://127.0.0.1:56379
TAH_DISTRIBUTED_REQUIRED=false
TAH_LEADER_LEASE_MS=15000
TAH_MAX_RESPONSE_BODY_BYTES=65536

# Production hardening
TAH_SESSION_SECRET=<generate-at-least-32-random-bytes>
TAH_SESSION_TTL_SECONDS=28800
TAH_PUBLIC_BASE_URL=https://traffic.example.com
TAH_DOMAIN=traffic.example.com
TAH_TLS_EMAIL=operations@example.com
TAH_ADMIN_USER=operator
TAH_ADMIN_PASSWORD_HASH=<caddy-bcrypt-hash>
TAH_DATABASE_SSL=1
TAH_DATABASE_SSL_REJECT_UNAUTHORIZED=1
TAH_DB_CONNECT_TIMEOUT_MS=10000
TAH_SCRIPT_DB_POOL_SIZE=10
TAH_SCRIPT_MAX_ATTEMPTS=8
TAH_SCRIPT_LEASE_MS=240000
TAH_SCRIPT_MIN_DELIVERY_INTERVAL_MS=58000
TAH_PROXY_LOCAL_PORT_MIN=12000
TAH_PROXY_LOCAL_PORT_MAX=64000
TAH_ALERT_WEBHOOK_URL=https://alerts.example.com/incoming
TAH_ALERT_WEBHOOK_SECRET=<provider-secret>
TAH_BACKUP_DIR=./backups
TAH_BACKUP_RETENTION_DAYS=14
# Production must use managed services; do not point these at the local compose containers.
DATABASE_URL=postgresql://user:password@managed-postgres.example:5432/traffic_armour?sslmode=require
REDIS_URL=rediss://managed-redis.example:6380
TAH_STATE_ENCRYPTION_KEY=
TAH_REQUIRE_ENCRYPTED_STATE=true
